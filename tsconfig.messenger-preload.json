{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": false,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "out/preload",
    "rootDir": "src/preload",
    "sourceMap": false,
    "declaration": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/preload/messenger-preload.ts"],
  "exclude": ["node_modules", "out", "dist"]
}
