{
  "name": "fm-sprachbox",
  "version": "0.3.1-p3",
  "description": "FM - Sprachbox: portable WhatsApp/Telegram Wrapper für Windows",
  "author": "Felix <md@merkeldesign.biz> und Hermes (KI-Entwicklungspartner)",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint src tests scripts --ext .ts,.tsx,.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.messenger-preload.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "smoke:p2": "node scripts/with-xvfb.mjs",
    "build": "npm run clean && npm run build:main && npm run build:preload && npm run build:preload:messenger && npm run build:renderer && npm run copy:assets",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "tsc -p tsconfig.preload.json && node scripts/rename-preload.mjs",
    "build:preload:messenger": "tsc -p tsconfig.messenger-preload.json && node scripts/rename-preload.mjs",
    "build:renderer": "vite build",
    "copy:assets": "node scripts/copy-assets.mjs",
    "clean": "rimraf out dist",
    "dev": "node scripts/dev.mjs",
    "electron": "electron out/main/index.js",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:win:zip": "npm run dist:win && node scripts/zip-unpacked.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "adm-zip": "^0.5.16",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "biz.merkeldesign.fm-sprachbox",
    "productName": "FM - Sprachbox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "!out/tests/**/*",
      "!**/*.map"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/branding/icon.ico"
    },
    "portable": {
      "artifactName": "FM-Sprachbox-${version}-portable-win64.${ext}"
    },
    "asar": true,
    "asarUnpack": []
  }
}
